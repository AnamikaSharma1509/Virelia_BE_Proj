APP_NAME=Virelia
APP_ENV=development
DEBUG=true

# Database URL
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5433/virelia_db

# Security
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_URL=http://localhost:5173

# Admin Provisioning
ADMIN_EMAIL=anamika.admin@gmail.com
ADMIN_INITIAL_PASSWORD=

# SMTP Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@virelia.com

# AI Configuration (local fallback by default)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# Media Storage
MEDIA_ROOT=../media
MAX_VIDEO_UPLOAD_MB=500
